# ==============================================================================
# DIGITAL HEROES - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Client & Server SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key
# CRITICAL SECURITY RULE:
# This key has full administrative rights and bypasses RLS.
# It MUST ONLY EVER be used server-side (in src/lib/supabase/admin.ts, webhooks, or server functions).
# NEVER prefix with NEXT_PUBLIC_ and NEVER import into client-side components.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Storage Bucket for Winner Score Screenshots
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=winner-proofs

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_51...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...

# Prize Pool Business Rule Configuration
# NOTE: The PRD mandates the 40% (tier 5) / 35% (tier 4) / 25% (tier 3) prize split,
# but does NOT state what percentage of each subscription enters the monthly prize pool.
# Explicit Demo Assumption: 30% of each active subscription fee is allocated to the draw prize pool.
SUBSCRIPTION_PRIZE_POOL_PERCENTAGE=30
